datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DEVELOPER
  REPORTER
  TRIAGER
}

enum Status {
  NEW
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Severity {
  TRIVIAL
  MINOR
  NORMAL
  MAJOR
  CRITICAL
  BLOCKER
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  role           Role           @default(DEVELOPER)
  avatarUrl      String?
  reportedIssues Issue[]        @relation("ReporterIssues")
  assignedIssues Issue[]        @relation("AssigneeIssues")
  comments       Comment[]
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String?
  issues      Issue[]
  components  Component[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Component {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model Issue {
  id          String    @id @default(cuid())
  key         String    @unique
  title       String
  description String
  status      Status    @default(NEW)
  priority    Priority  @default(MEDIUM)
  severity    Severity  @default(NORMAL)
  environment String?
  version     String?
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  
  componentId String?
  component   Component? @relation(fields: [componentId], references: [id])
  
  reporterId  String
  reporter    User      @relation("ReporterIssues", fields: [reporterId], references: [id])
  
  assigneeId  String?
  assignee    User?     @relation("AssigneeIssues", fields: [assigneeId], references: [id])

  comments    Comment[]
  auditLogs   AuditLog[]
  
  blocks      IssueDependency[] @relation("BlockingIssue")
  blockedBy   IssueDependency[] @relation("BlockedIssue")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IssueDependency {
  id             String @id @default(cuid())
  blockingIssueId String
  blockingIssue   Issue  @relation("BlockingIssue", fields: [blockingIssueId], references: [id], onDelete: Cascade)
  
  blockedIssueId  String
  blockedIssue   Issue  @relation("BlockedIssue", fields: [blockedIssueId], references: [id], onDelete: Cascade)

  @@unique([blockingIssueId, blockedIssueId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}